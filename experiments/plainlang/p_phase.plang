# Changes behaviour halfway: 15 interactive-style events, then a long
# computation. One static hint can't describe both halves.
repeat 15 times
wait 0.015
set s to 0
count i from 1 to 100
set s to s plus i
end
end
set found to 0
count n from 2 to 30000
set isprime to true
set d to 2
while d multiplied by d is at most n
if remainder of n and d is equal to 0 then
set isprime to false
stop
end
set d to d plus 1
end
if isprime then
set found to found plus 1
end
end
say "phase program done: " plus found
