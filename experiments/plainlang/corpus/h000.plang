define boundb with a
return a
end
count ra from 1 to 32
set sa to 0
count ia from 1 to 10
set sa to sa plus ia
end
if remainder of ra and 5 is 0 then
wait 0.008
end
end
count rb from 1 to 14
set sb to 0
set nb to boundb with 131
set xb to 0
while xb is less than nb
set xb to xb plus 1
end
wait 0.004
end
say "done"
