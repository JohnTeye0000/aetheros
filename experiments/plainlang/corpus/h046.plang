define boundb with a
return a
end
count ra from 1 to 6
set sa to 0
set xa to 0
set ya to 0
while ya is less than 48340
set xa to xa plus 1
set ya to xa
end
wait 0.015
end
count rb from 1 to 27
set sb to 0
set nb to boundb with 13
set xb to 0
while xb is less than nb
set xb to xb plus 1
end
end
say "done"
