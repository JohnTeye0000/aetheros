count ra from 1 to 24
set sa to 0
set xa to 0
while xa is less than 85
set xa to xa plus 1
set sa to sa plus xa
end
end
count rb from 1 to 30
set sb to 0
set xb to 0
while xb is less than 579
set xb to xb plus 1
set sb to sb plus xb
end
if remainder of rb and 4 is 0 then
wait 0.004
end
end
say "done"
