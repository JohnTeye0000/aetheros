count ra from 1 to 15
set sa to 0
set xa to 0
set ya to 0
while ya is less than 2235
set xa to xa plus 1
set ya to xa
end
end
count rb from 1 to 13
set sb to 0
set xb to 0
set yb to 0
while yb is less than 2718
set xb to xb plus 1
set yb to xb
end
if remainder of rb and 4 is 0 then
wait 0.015
end
end
say "done"
