define bounda with a
return a
end
count ra from 1 to 6
set sa to 0
set na to bounda with 51
set xa to 0
while xa is less than na
set xa to xa plus 1
end
if remainder of ra and 4 is 0 then
wait 0.004
end
end
count rb from 1 to 17
set sb to 0
set xb to 0
while xb is less than 697
set xb to xb plus 1
set sb to sb plus xb
end
wait 0.008
end
say "done"
