define bounda with a
return a
end
count ra from 1 to 38
set sa to 0
set na to bounda with 5773
set xa to 0
while xa is less than na
set xa to xa plus 1
end
wait 0.008
end
count rb from 1 to 6
set sb to 0
count ib from 1 to 782
set sb to sb plus ib
end
if remainder of rb and 3 is 0 then
wait 0.002
end
end
say "done"
